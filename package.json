{
  "name": "mailer-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "mail:up": "docker compose up -d",
    "mail:down": "docker compose down",
    "mail:seed": "node scripts/seed.mts"
  },
  "dependencies": {
    "imapflow": "^2.4.0",
    "mailparser": "^3.9.38",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^25.9.9",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
