# .env.local にコピーして使う(.env.local は git に含めない)

# --- ローカル AI(OpenAI 互換 API)。設定画面からも変更できる ---
AI_BASE_URL=http://localhost:8080/v1
# 埋め込みモデルを別のサーバで動かしている場合(llama-server など)
AI_EMBED_BASE_URL=http://localhost:8082/v1
# AI_CHAT_MODEL=
# AI_EMBED_MODEL=
# キーが必要な接続先の場合。上の 2 つの URL にだけ送られる
# AI_API_KEY=

# --- 実アカウント(任意)。ふだんは設定画面で入力する(パスワードは macOS のキーチェーンに保存)。ここに書いた値は初期値になる ---
# REAL_MAIL_ADDRESS=you@example.com
# REAL_MAIL_NAME=表示名
# REAL_MAIL_PASSWORD=アプリ用パスワード
# REAL_IMAP_HOST=imap.example.com
# REAL_IMAP_PORT=993
# REAL_SMTP_HOST=smtp.example.com
# REAL_SMTP_PORT=465
# REAL_MAIL_USER=
# REAL_SENT_MAILBOX=
# REAL_APPEND_SENT=false
