# .env.local にコピーして使う(.env.local は git に含めない)

# --- ローカル AI(OpenAI 互換 API)。設定画面からも変更できる ---
AI_BASE_URL=http://localhost:8080/v1
# 埋め込みモデルを別のサーバで動かしている場合(llama-server など)
AI_EMBED_BASE_URL=http://localhost:8082/v1
# AI_CHAT_MODEL=
# AI_EMBED_MODEL=
# キーが必要な接続先の場合。上の 2 つの URL にだけ送られる
# AI_API_KEY=

# --- メールアカウント(任意)。ふだんは設定画面で入力する(パスワードは macOS のキーチェーンに保存)。ここに書いた値は初期値になる ---
# REAL_MAIL_ADDRESS=you@example.com
# REAL_MAIL_NAME=表示名
# REAL_MAIL_PASSWORD=アプリ用パスワード
# REAL_IMAP_HOST=imap.example.com
# REAL_IMAP_PORT=993
# REAL_SMTP_HOST=smtp.example.com
# REAL_SMTP_PORT=465
# REAL_MAIL_USER=
# REAL_SENT_MAILBOX=
# REAL_APPEND_SENT=false
# 差出人の偽装の判定で信じる、受信サーバの認証結果(Authentication-Results)の発行元。既定は Gmail(mx.google.com)。カンマ区切り
# MAILER_AUTHSERV_IDS=mx.google.com

# --- 外から開く入口(任意)。Cloudflare Tunnel + Cloudflare Access の先で使う公開ホスト名。docs/cloudflare.md を参照 ---
# MAILER_PUBLIC_HOST=mail.example.com
# 公開ホストは Cloudflare Access の JWT を確かめたリクエストだけ通す。2 つとも無いと公開ホストはすべて 403
# MAILER_ACCESS_TEAM_DOMAIN=<チーム名>.cloudflareaccess.com
# MAILER_ACCESS_AUD=<Access アプリの Application Audience (AUD) Tag>
